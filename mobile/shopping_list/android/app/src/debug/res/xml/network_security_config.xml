<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: they may talk plain http to a server on the local network
     (a PC running `php artisan serve`). The release build keeps the strict rules in main. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
